<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F8">

    <ImageView
        android:id="@+id/topBooks"
        android:layout_width="260dp"
        android:layout_height="120dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/main_img1"
        android:scaleType="fitCenter"
        android:contentDescription="책장 위의 책"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/bookShelf"
        android:layout_width="260dp"
        android:layout_height="120dp"
        android:src="@drawable/main_img2"
        android:scaleType="fitCenter"
        android:contentDescription="고양이가 있는 책장"
        app:layout_constraintTop_toBottomOf="@id/topBooks"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/welcomeMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="도서 쇼핑몰에 오신 걸 환영합니다!"
        android:textColor="#444444"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/bookShelf"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/startShoppingButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/main_btn"
        android:scaleType="fitCenter"
        android:contentDescription="시작하기"
        app:layout_constraintTop_toBottomOf="@id/welcomeMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:src="@drawable/main_img3"
        android:scaleType="fitEnd"
        android:contentDescription="책을 읽는 사람과 고양이"
        app:layout_constraintTop_toBottomOf="@id/startShoppingButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>