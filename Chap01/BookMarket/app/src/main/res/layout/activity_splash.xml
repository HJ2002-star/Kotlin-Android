<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="180dp">

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="150dp"
                android:layout_height="170dp"
                android:layout_gravity="end|top"
                android:layout_marginEnd="15dp"
                android:src="@drawable/splash_logo_animation"
                android:scaleType="fitCenter"
                android:contentDescription="BookStore 로고" />

            <ImageView
                android:id="@+id/splashWalker"
                android:layout_width="80dp"
                android:layout_height="107dp"
                android:layout_gravity="start|bottom"
                android:src="@drawable/splash_walk_animation"
                android:scaleType="fitCenter"
                android:contentDescription="책을 읽으며 걷는 사람" />
        </FrameLayout>

        <ImageView
            android:layout_width="200dp"
            android:layout_height="33dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/splash_text"
            android:scaleType="fitCenter"
            android:contentDescription="BookStore" />
    </LinearLayout>

</FrameLayout>
