<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#123C4B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="#A8BF7B">

        <TextView
            android:id="@+id/calculationExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="28dp"
            android:gravity="end|center_vertical"
            android:textColor="#344628"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/calculationResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:gravity="end|center_vertical"
            android:text="0"
            android:textColor="#263820"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/calculatorKeys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="4"
        android:rowCount="5" />

    <Button
        android:id="@+id/closeCalculatorButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#D6457D"
        android:text="닫기"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>