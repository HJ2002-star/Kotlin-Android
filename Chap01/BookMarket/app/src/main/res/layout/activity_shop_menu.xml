<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shopDrawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/shopContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/shopToolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:minHeight="56dp"
            android:background="#459E9E"
            app:title="BookMarket"
            app:titleTextColor="#FFFFFF"
            app:navigationIcon="@drawable/icon_navi"
            app:navigationContentDescription="탐색 메뉴 열기" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:src="@drawable/menu_logo"
                    android:scaleType="fitStart"
                    android:contentDescription="BookMarket 로고" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="16dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/menu_banner1"
                        android:scaleType="fitCenter"
                        android:contentDescription="도서 쇼핑몰 배너" />

                    <ImageView
                        android:layout_width="160dp"
                        android:layout_height="90dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="20dp"
                        android:src="@drawable/menu_text"
                        android:scaleType="fitCenter"
                        android:contentDescription="추천 도서 안내" />
                </FrameLayout>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/menu_title"
                    android:scaleType="fitCenter"
                    android:contentDescription="Categories" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/openBooksButton"
                        android:layout_width="0dp"
                        android:layout_height="88dp"
                        android:layout_weight="1"
                        android:padding="8dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/menu_menu1"
                        android:scaleType="fitCenter"
                        android:contentDescription="도서목록" />

                    <ImageButton
                        android:id="@+id/ebookButton"
                        android:layout_width="0dp"
                        android:layout_height="88dp"
                        android:layout_weight="1"
                        android:padding="8dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/menu_menu2"
                        android:scaleType="fitCenter"
                        android:contentDescription="E-Book" />

                    <ImageButton
                        android:id="@+id/customerButton"
                        android:layout_width="0dp"
                        android:layout_height="88dp"
                        android:layout_weight="1"
                        android:padding="8dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/menu_menu3"
                        android:scaleType="fitCenter"
                        android:contentDescription="고객센터" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/myPageButton"
                        android:layout_width="0dp"
                        android:layout_height="88dp"
                        android:layout_weight="1"
                        android:padding="8dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/menu_menu4"
                        android:scaleType="fitCenter"
                        android:contentDescription="나의페이지" />

                    <ImageButton
                        android:id="@+id/marketButton"
                        android:layout_width="0dp"
                        android:layout_height="88dp"
                        android:layout_weight="1"
                        android:padding="8dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/menu_menu5"
                        android:scaleType="fitCenter"
                        android:contentDescription="마켓정보" />

                    <ImageButton
                        android:id="@+id/settingsButton"
                        android:layout_width="0dp"
                        android:layout_height="88dp"
                        android:layout_weight="1"
                        android:padding="8dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/menu_menu6"
                        android:scaleType="fitCenter"
                        android:contentDescription="설정" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="20dp"
            android:src="@drawable/menu_bottom"
            android:scaleType="fitCenter"
            android:contentDescription="하단 메뉴" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/shopNavigation"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFF8F8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#EFA957">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="120dp"
                android:src="@drawable/navi_market"
                android:scaleType="fitCenter"
                android:contentDescription="책방 그림" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="BookMarket"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/navLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:drawableStart="@drawable/icon_login"
            android:drawablePadding="16dp"
            android:text="로그인"
            android:textColor="#333333"
            android:textSize="16sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/navSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:drawableStart="@drawable/icon_setting"
            android:drawablePadding="16dp"
            android:text="환경설정"
            android:textColor="#333333"
            android:textSize="16sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/navMyInfo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:drawableStart="@drawable/icon_myinfo"
            android:drawablePadding="16dp"
            android:text="나의정보"
            android:textColor="#333333"
            android:textSize="16sp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>