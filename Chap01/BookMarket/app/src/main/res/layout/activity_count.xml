<?xml version="1.0" encoding="utf-8"?>
<TableLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#FFF8F8"
    android:stretchColumns="1">

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_span="2"
            android:layout_marginBottom="20dp"
            android:text="TableLayout 실습"
            android:textColor="#8BA847"
            android:textSize="22sp"
            android:textStyle="bold|italic" />
    </TableRow>

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/turtleCount"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="2"
            android:textColor="#222222"
            android:textSize="22sp"
            android:contentDescription="거북이 개수 입력" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:src="@drawable/turtle"
            android:scaleType="fitStart"
            android:contentDescription="거북이 그림" />
    </TableRow>

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/fishCount"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="2"
            android:textColor="#222222"
            android:textSize="22sp"
            android:contentDescription="물고기 개수 입력" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:src="@drawable/fish"
            android:scaleType="fitStart"
            android:contentDescription="물고기 그림" />
    </TableRow>

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/checkAnswerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_span="2"
            android:layout_marginTop="16dp"
            android:backgroundTint="#26A6B8"
            android:text="결과보기"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </TableRow>

</TableLayout>